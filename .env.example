# Copy to .env and fill in real values. Never commit .env.

# --- Mission defaults (gpt-oss text + Agnes image) ---
LLM_PROVIDER=gptoss
MISSION_TEXT_MODEL=gptoss
MISSION_IMAGE_MODEL=agnes
NVIDIA_API_KEY=
AGNES_API_KEY=
DEEPSEEK_API_KEY=
# AGNES_IMAGE_MODEL=agnes-image-2.0-flash
# NVIDIA_TEXT_MODEL=openai/gpt-oss-20b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TEXT_MODEL=deepseek-flash

# Optional Gemini — ONLY used when an operator pastes a key in the Models chip.
# Do not set these for local Mission defaults (avoids free-tier rate limits).
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- YouTube Data API v3 (ingestion; free quota). Falls back to yt-dlp if unset. ---
YOUTUBE_API_KEY=

# --- Postgres (used by ingestion, intelligence, gateway) ---
POSTGRES_USER=rivalradar
POSTGRES_PASSWORD=rivalradar
POSTGRES_DB=rivalradar
DATABASE_URL=postgresql+asyncpg://rivalradar:rivalradar@localhost:5432/rivalradar

# --- Redis (gateway caching/task state) ---
REDIS_URL=redis://localhost:6379/0

# --- Inter-service URLs (set automatically inside docker-compose; override for local dev) ---
INGESTION_SERVICE_URL=http://localhost:8001
INTELLIGENCE_SERVICE_URL=http://localhost:8002
GENERATION_SERVICE_URL=http://localhost:8003
COMPLIANCE_SERVICE_URL=http://localhost:8004

# --- Frontend ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# --- Deploy / CORS (comma-separated). Add your Vercel URL in production. ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Connection vault (required in production; random 32+ chars) ---
CONNECTION_VAULT_KEY=

# --- Redis (use "memory" on Render free tier; Upstash URL for live scout WS) ---
REDIS_URL=memory

# --- Supabase visitor analytics (gateway only; never expose service role to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Never put LinkedIn/X/IG session cookies in env. Users log in via the Connect browser.
DISALLOW_ENV_SOCIAL_COOKIES=true
