LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Nano Banana 2 — native generateContent (not OpenAI chat.completions)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Mission defaults when the operator pastes no keys in the Models chip:
# gpt-oss text (NVIDIA) + Agnes image. Uncomment + fill to enable server-side.
# NVIDIA_API_KEY=nvapi-your-nvidia-key
# AGNES_API_KEY=sk-your-agnes-key
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# MISSION_TEXT_MODEL=gptoss
# MISSION_IMAGE_MODEL=agnes
